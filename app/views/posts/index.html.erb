<div class="cover-index">
  <div class="container d-flex flex-column align-items-center">
    
    <div class="row mt-5">
      <h1 class="font-weight-normal">旅行投稿一覧</h1>
    </div>
    <div class="row mt-3 mb-3 align-self-end">
     <%= form_with method: :get, local: true do |f| %>
       <%= f.text_field :search %>
       <%= f.submit '検索する', name: nil %>
     <% end %>
    </div>
    <%# row の直下に each で col を繰り返し生成する構造に修正 %>
    <div class="row mt-5 index-left w-100">
      <% @posts.each do |post| %>
        <div class="one-post col-sm-4 mb-3">
          <%= link_to post_path(post) do %>
            <%# 投稿者の名前を動的に表示 %>

            <%# user が nil のときはエラーを出さずに何も表示しない（または nil を返す） %>
            <p class="caption"><%= post.user&.name %></p>
            
            <% if post.image.attached? %>
            <%= image_tag post.image, size: "300x200" %>
            <% else %>
            <p class="no-image">No Image</p>
            <% end %>

            <p class="caption"><%= post.location %></p>
            <p class="caption"><%= "#{post.comments.count} コメント" %></p>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# ページネーション %>
    <div class="mt-4">
      <%= paginate @posts %>
    </div>

  </div>
</div>